{
    "name": "OKF Bundle Hub",
    "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

    // MONTAGE : le répertoire du hub, et lui seul (§ 4.3). Les outils MCP ne
    // doivent jamais pouvoir atteindre le système de fichiers de l'hôte hors
    // de bases-dir. Ne pas ajouter de mount supplémentaire sans mesurer ce que
    // cela ouvre : le confinement des chemins de kb_read (§ 5.3) protège le
    // corpus, pas l'hôte.
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/okf-hub,type=bind,consistency=cached",
    "workspaceFolder": "/workspaces/okf-hub",

    // MONTAGE SSH : un **volume nommé**, jamais un répertoire de l'hôte. Écart
    // assumé à la lettre du § 4.3 (« montage : le répertoire du hub
    // uniquement »), recensé en ARCHITECTURE.md § 5.3 avec sa mesure et la
    // manière de l'annuler. Le motif de la règle — « les outils ne doivent
    // jamais accéder hors de bases-dir » — est préservé : un volume Docker
    // n'expose aucun chemin de l'hôte, il ne fait que survivre aux rebuilds.
    // Ce qu'il porte : les clés SSH du conteneur — **une deploy key par
    // dépôt**, jamais une clé personnelle, dont la compromission ouvrirait
    // tous les dépôts du compte depuis un conteneur où tournent des sessions
    // Claude. Elles sont générées par deploy-keys.sh, qui écrit aussi le
    // ~/.ssh/config associant chaque dépôt à la sienne ; ce script porte le
    // raisonnement complet, et tests/test_devcontainer.py garde la promesse.
    // Ne pas transformer ce montage en bind sur ~/.ssh de l'hôte : ce serait
    // exactement ce que le § 4.3 interdit, et la clé personnelle avec.
    "mounts": [
        "source=okf-hub-devcontainer-ssh,target=/home/vscode/.ssh,type=volume"
    ],

    "features": {
        "ghcr.io/devcontainers/features/git:1": {}
    },

    "postCreateCommand": "bash .devcontainer/post-create.sh",

    "remoteEnv": {
        "OKF_HUB_ROOT": "${containerWorkspaceFolder}",
        "OKF_HUB_PYTHON": "${containerWorkspaceFolder}/.venv/bin/python",
        "PATH": "${containerWorkspaceFolder}/bin:${containerEnv:PATH}"
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "redhat.vscode-yaml"
            ],
            "settings": {
                "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
                "files.encoding": "utf8"
            }
        }
    }
}
