# Le hub n'embarque jamais les clones de bases : elles sont importées par
# `git clone <url> bases/<nom>` (§ 4.2) et vivent leur propre vie git.
/bases/*
!/bases/.gitkeep

# Identité git de l'opérateur du conteneur, lue par post-create.sh. Locale à
# la machine et jamais versionnée : chaque mainteneur a la sienne, et une
# adresse personnelle n'a rien à faire dans le dépôt.
/.devcontainer/git-identity.env

# Journal du hub (§ 4.1)
hub.log
*.log

# Verrous de base (§ 4.4.b.1) — ceinture et bretelles, ils vivent dans les
# dépôts de bases, jamais ici.
.okf-hub.lock

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/
dist/
build/
